{
  "name": "daily-stars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "MOCK_PARENT=1 vite --host 127.0.0.1",
    "dev:mock": "MOCK_PARENT=1 vite --host 127.0.0.1",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file fixtures/local.sql",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "jose": "6.2.16",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
