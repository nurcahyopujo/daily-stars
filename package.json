{
  "name": "daily-stars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.22.3"
  },
  "scripts": {
    "dev": "MOCK_PARENT=1 vite --host 127.0.0.1",
    "dev:mock": "MOCK_PARENT=1 vite --host 127.0.0.1",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser:chromium": "rm -rf .wrangler/browser-tests-chromium && DAILY_STARS_BROWSER_DB=.wrangler/browser-tests-chromium playwright test --project=chromium",
    "test:browser:webkit": "rm -rf .wrangler/browser-tests-webkit && DAILY_STARS_BROWSER_DB=.wrangler/browser-tests-webkit playwright test --project=webkit",
    "test:browser": "npm run test:browser:chromium && npm run test:browser:webkit",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file fixtures/local.sql",
    "check:fast": "npm run typecheck && npm run lint && npm test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-router": "^1.161.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jose": "6.2.16",
    "lucide-react": "^1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
